<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

    <!--
      EI_EXPOSE_REP / EI_EXPOSE_REP2: heredado del proyecto base. Los beans de Spring, entidades
      JPA y DTOs (records) comparten referencias por getters; no es un bug real en este contexto.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
      CT_CONSTRUCTOR_THROW: los beans de Spring validan su configuracion en el constructor
      (clave AES, secreto JWT) y fallan rapido al arrancar. No se serializan ni se extienden.
    -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!--
      SecurityConfig.filterChain declara "throws Exception" porque HttpSecurity.build() lo exige.
    -->
    <Match>
        <Class name="cl.crealab.atlas.infrastructure.config.SecurityConfig"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>
</FindBugsFilter>
