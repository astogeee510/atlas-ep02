# Copie este archivo a infra/.env o ejecute: bash scripts/generar-env.sh
# NUNCA suba infra/.env al repositorio.
ATLAS_DB_USER=atlas
ATLAS_DB_PASSWORD=cambiar-por-un-valor-aleatorio
# Base64 de 48 bytes aleatorios:  openssl rand -base64 48
ATLAS_JWT_SECRET=
# Base64 de 32 bytes aleatorios (AES-256):  openssl rand -base64 32
ATLAS_CRYPTO_KEY=
